# Zuno Meme Live - Example Environment Variables 
# Copy this file to `.env.local` and fill in the values. 
NEXT_PUBLIC_APP_URL=
# Secret used to sign iframe auth tokens. 
# Use a strong, randomly generated value and rotate periodically. 
IFRAME_API_SECRET=change-me-to-a-long-random-secret 
 
# Comma-separated list of allowed origins for CORS in development. 
# Example assumes the Next.js app (:3000) and the static test host (:3001). 
NEXT_PUBLIC_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
