# Zuno Marketplace Event Stream - Environment Variables
# Copy this file to `.env.local` and fill in the values.

# ============================================================================
# Security - IFrame Authentication
# ============================================================================

# Secret used to sign iframe auth tokens (HMAC SHA256)
# Use a strong, randomly generated value (min 32 chars) and rotate periodically
# Generate with: openssl rand -hex 32
IFRAME_API_SECRET=change-me-to-a-long-random-secret-min-32-characters-please

# Comma-separated list of allowed origins for CORS
# This is your SECURITY WHITELIST - Only these domains can embed the widget
#
# Examples:
# - Development: http://localhost:3000,http://localhost:3001
# - Production: https://clientA.com,https://clientB.com,https://app.example.com
# - Wildcard subdomain: https://*.example.com (allows any subdomain)
#
# ⚠️ IMPORTANT: Keep this list minimal! Each domain = potential attack vector
NEXT_PUBLIC_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# ============================================================================
# Ponder API Configuration
# ============================================================================

# Ponder indexer API base URL (no trailing slash)
NEXT_PUBLIC_PONDER_API_URL=http://localhost:42069

# Optional: API key for Ponder API (if authentication is enabled)
# NEXT_PUBLIC_PONDER_API_KEY=your-ponder-api-key-here

# ============================================================================
# Application Configuration
# ============================================================================

# Public app URL (for generating iframe embed URLs)
NEXT_PUBLIC_APP_URL=http://localhost:3000
